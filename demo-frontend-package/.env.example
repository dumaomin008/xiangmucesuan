# 当前 DEMO 默认可零配置运行（本地引擎解读）。
# 如需领导演示时启用真实大模型润色，仅在本机 .env 填写，禁止提交真实值。

# DEMO_AI_API_KEY=
# DEMO_AI_BASE_URL=https://api.openai.com/v1
# DEMO_AI_MODEL=gpt-4o-mini

# 资料语义提取。Key 只放本机环境变量，禁止提交。
# 未设置 AI_* 时回退到 DEMO_AI_*。
# DOCUMENT_PARSER_MODE=real
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-flash
