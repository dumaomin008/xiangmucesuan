{
  "name": "project-calculation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:calc": "vitest run src/lib/engine/__tests__ tests/golden src/calculation/__tests__",
    "test:calc:consistency": "vitest run src/calculation/__tests__/browser-consistency.test.ts",
    "test:demo": "vitest run src/demo/__tests__",
    "test:phase12": "vitest run src/lib/engine/__tests__ tests/golden src/calculation/__tests__ src/demo/__tests__",
    "test:phase3": "vitest run src/demo/__tests__/phase3-fusion.test.ts",
    "build:demo-calc": "node scripts/build-demo-calc-bundle.mjs",
    "test:integration": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:acceptance": "npx tsx scripts/run-acceptance.ts",
    "test:db:init": "npx tsx scripts/run-init-acceptance-db.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.12.3",
    "next": "^15.5.4",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.2",
    "@types/node": "^22.18.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
